# Lesson 03: count, for_each, conditionals, and for expressions

terraform {
  required_version = ">= 1.5.0"

  required_providers {
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
  }
}

variable "create_readme" {
  description = "Conditional resource: create the README file or not"
  type        = bool
  default     = true
}

variable "servers" {
  description = "Map of servers to generate files for"
  type        = map(string)
  default = {
    web = "10.0.0.10"
    api = "10.0.0.20"
    db  = "10.0.0.30"
  }
}

# count: create N copies, addressed by index
resource "local_file" "numbered" {
  count    = 3
  filename = "${path.module}/output/numbered-${count.index}.txt"
  content  = "I am file number ${count.index}\n"
}

# for_each: one resource per map entry, addressed by key
resource "local_file" "server" {
  for_each = var.servers
  filename = "${path.module}/output/server-${each.key}.txt"
  content  = "Server ${each.key} lives at ${each.value}\n"
}

# Conditional: count = 0 or 1 turns a resource on/off
resource "local_file" "readme" {
  count    = var.create_readme ? 1 : 0
  filename = "${path.module}/output/README.txt"
  content  = "Generated by Terraform lesson 03.\n"
}

# for expression: transform a collection
output "server_files" {
  description = "Map of server name to file path"
  value       = { for name, f in local_file.server : name => f.filename }
}

output "uppercase_names" {
  value = [for name in keys(var.servers) : upper(name)]
}
